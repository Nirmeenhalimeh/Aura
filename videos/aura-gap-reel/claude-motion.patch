@@ -0,0 +1,522 @@
+import React, {useEffect, useState} from 'react';
+import {AbsoluteFill, continueRender, delayRender, useCurrentFrame} from 'remotion';
+import {Grain} from '../components/primitives';
+import {
+  A,
+  AF,
+  FPS,
+  H,
+  Pt,
+  TL,
+  W,
+  clamp01,
+  expoIn,
+  expoInOut,
+  expoOut,
+  lerp,
+  mix,
+  prog,
+  resample,
+  toPath,
+} from './theme';
+
+const useAuraFonts = () => {
+  const [handle] = useState(() => delayRender('aura-fonts'));
+  useEffect(() => {
+    // Passing sample text makes the browser fetch the Arabic unicode-range subset too.
+    Promise.all([
+      document.fonts.load('700 100px "IBM Plex Sans Arabic"', 'مكسور الفجوة؟'),
+      document.fonts.load('400 100px "IBM Plex Sans Arabic"', 'انتباه رسالة'),
+      document.fonts.load('600 100px "Inter Variable"', 'Aura AI 0123456789,'),
+    ]).then(() => continueRender(handle));
+  }, [handle]);
+};
+
+/* ---------- Scene 1: hook ---------- */
+
+const CRACK: Pt[] = [[54, -40], [49, 8], [57, 30], [46, 52], [56, 74], [49, 96], [52, 140]];
+const poly = (pts: Pt[]) => `polygon(${pts.map(([x, y]) => `${x}% ${y}%`).join(',')})`;
+const RIGHT_HALF = poly([[140, -40], [140, 140], ...[...CRACK].reverse()]);
+const LEFT_HALF = poly([[-40, -40], ...CRACK, [-40, 140]]);
+
+const lineStyle: React.CSSProperties = {
+  position: 'absolute',
+  left: 0,
+  right: 0,
+  top: 0,
+  height: 1760,
+  display: 'flex',
+  flexDirection: 'row',
+  direction: 'rtl',
+  justifyContent: 'center',
+  alignItems: 'center',
+  gap: '0.26em',
+  fontFamily: AF.ar,
+  fontWeight: 700,
+  fontSize: 112,
+  lineHeight: 1.35,
+  color: A.text,
+};
+
+const snap = (t: number, start: number): React.CSSProperties => ({
+  display: 'inline-block',
+  opacity: t >= start ? 1 : 0,
+  transform: `scale(${lerp(1.2, 1, prog(t, start, start + 8 / FPS, expoOut))})`,
+});
+
+const Hook: React.FC<{t: number; frame: number}> = ({t, frame}) => {
+  const s = TL.s1;
+  const flashF = Math.round(s.flash * FPS);
+  if (t >= s.exit + 0.3) return null;
+  if (frame < flashF) {
+    const words = ['المحتوى', 'عم', 'يشتغل…'];
+    return (
+      <div dir="rtl" style={lineStyle}>
+        {words.map((w, i) => (
+          <span key={w} style={snap(t, s.words1[i])}>
+            {w}
+          </span>
+        ))}
+      </div>
+    );
+  }
+  if (frame < flashF + 2) return <AbsoluteFill style={{background: A.accent}} />;
+
+  const drift = 10 * prog(t, s.crack, s.crack + 0.35, expoOut); // halves end 20px apart
+  const out = 820 * prog(t, s.exit, s.exit + 0.22, expoIn); // the crack splits the frame open
+  const right = (extra = 0, rot = 0): React.CSSProperties => ({
+    position: 'absolute',
+    inset: 0,
+    transform: `translateX(${extra + out}px) rotate(${rot}deg)`,
+  });
+  return (
+    <div dir="rtl" style={lineStyle}>
+      {['بس', 'الطريق'].map((w, i) => (
+        <span key={w} style={{...snap(t, s.words2[i]), transform: `${snap(t, s.words2[i]).transform} translateX(${out}px)`}}>
+          {w}
+        </span>
+      ))}
+      <span style={{...snap(t, s.words2[2]), position: 'relative'}}>
+        <span style={{visibility: 'hidden'}}>مكسور.</span>
+        <span style={{...right(drift, 1.2 * (drift / 10)), clipPath: RIGHT_HALF}}>مكسور.</span>
+        <span
+          style={{
+            position: 'absolute',
+            inset: 0,
+            clipPath: LEFT_HALF,
+            transform: `translateX(${-drift - out}px) rotate(${-1.6 * (drift / 10)}deg)`,
+          }}
+        >
+          مكسور.
+        </span>
+      </span>
+    </div>
+  );
+};
+
+/* ---------- Scene 2 → 3: journey path, nodes become funnel bars ---------- */
+
+const NX = [910, 725, 540, 355, 170];
+const PATH_Y = 900;
+const LABELS = ['انتباه', 'زيارة البروفايل', 'ثقة', 'رسالة', 'بيع'];
+const GAP_MID = (NX[2] + NX[3]) / 2;
+
+const BAR_R = 990;
+const BAR_Y0 = 690;
+const BAR_H = 128;
+const BAR_STEP = 162;
+const BAR_W = [900, 700, 520, 350, 210];
+const VALUES = [10000, 1800, 240, 12, 3];
+const barCy = (i: number) => BAR_Y0 + i * BAR_STEP + BAR_H / 2;
+
+const drawP = (t: number) => prog(t, TL.s2.draw, TL.s2.drawEnd, expoInOut);
+const lineX = (t: number) => NX[0] - drawP(t) * (NX[0] - NX[4]);
+const POP_T = NX.map((x) => {
+  for (let t = TL.s2.draw; t <= TL.s2.drawEnd; t += 1 / 240) if (lineX(t) <= x + 0.5) return t;
+  return TL.s2.drawEnd;
+});
+const barStart = (i: number) => TL.s3.bars + i * 0.15;
+
+const Journey: React.FC<{t: number}> = ({t}) => {
+  const s = TL.s2;
+  if (t < s.draw || t > TL.s3.bars + 1.2) return null;
+  const g = prog(t, s.break, s.break + 0.45, expoOut);
+  const u = clamp01((t - s.break) / 0.5);
+  const shake = t >= s.break && u < 1 ? 4 * Math.sin(u * Math.PI * 2 * 3) : 0;
+  const lineOut = 1 - prog(t, s.exit, s.exit + 0.22, expoIn);
+  const labelOut = prog(t, s.exit, s.exit + 0.25, expoIn);
+  const toBar = prog(t, s.toBars, s.toBars + 0.6, expoInOut);
+  const xEnd = lineX(t);
+  const gapHalf = 52 * g;
+  const after = 1 - 0.62 * g; // downstream of the break dims
+  const segs: [number, number, number][] = [];
+  if (g <= 0) segs.push([NX[0], xEnd, 1]);
+  else {
+    segs.push([NX[0], Math.max(xEnd, GAP_MID + gapHalf), 1]);
+    if (xEnd < GAP_MID - gapHalf) segs.push([GAP_MID - gapHalf, xEnd, after]);
+  }
+  return (
+    <AbsoluteFill>
+      <svg width={W} height={H} style={{position: 'absolute'}}>
+        {segs.map(([a, b, o], i) => (
+          <line key={i} x1={a} x2={b} y1={PATH_Y} y2={PATH_Y} stroke={A.accent} strokeWidth={4} strokeLinecap="round" opacity={o * lineOut} />
+        ))}
+        {NX.map((x, i) => {
+          const pop = prog(t, POP_T[i], POP_T[i] + 0.35, expoOut);
+          const bad = i === 2 ? g : 0;
+          const col = mix(A.accent, A.alert, bad);
+          const dim = i > 2 ? lerp(1, after, toBar > 0 ? 1 - toBar : 1) : 1;
+          const cx = lerp(x + (i === 2 ? shake : 0), BAR_R, toBar);
+          const cy = lerp(PATH_Y, barCy(i), toBar);
+          const merge = 1 - prog(t, barStart(i) - 0.1, barStart(i) + 0.12, expoIn);
+          const sc = pop * merge;
+          if (sc <= 0) return null;
+          return (
+            <g key={i} transform={`translate(${cx} ${cy}) scale(${sc})`} opacity={dim}>
+              <circle r={20} fill={A.bg} stroke={col} strokeWidth={4} />
+              <circle r={7} fill={col} />
+            </g>
+          );
+        })}
+      </svg>
+      {NX.map((x, i) => {
+        const a = prog(t, POP_T[i] + 0.05, POP_T[i] + 0.45, expoOut);
+        const dim = i > 2 ? after : 1;
+        return (
+          <div
+            key={i}
+            dir="rtl"
+            style={{
+              position: 'absolute',
+              left: x - 85 + (i === 2 ? shake : 0),
+              width: 170,
+              top: PATH_Y + 44,
+              textAlign: 'center',
+              fontFamily: AF.ar,
+              fontWeight: i === 2 ? 700 : 400,
+              fontSize: 38,
+              lineHeight: 1.25,
+              color: i === 2 ? mix(A.text, A.alert, g) : A.text,
+              opacity: a * dim * (1 - labelOut),
+              transform: `translateY(${(1 - a) * 16 + labelOut * 20}px)`,
+            }}
+          >
+            {LABELS[i]}
+          </div>
+        );
+      })}
+    </AbsoluteFill>
+  );
+};
+
+/* ---------- Scene 3: numbers ---------- */
+
+const BRACKET: Pt[] = [
+  [458, barCy(2)],
+  [426, barCy(2)],
+  [426, 1140],
+  [408, 1153],
+  [434, 1166],
+  [426, 1178],
+  [426, barCy(3)],
+  [458, barCy(3)],
+];
+
+const Funnel: React.FC<{t: number}> = ({t}) => {
+  const s = TL.s3;
+  if (t < s.label || t > s.exit + 0.6) return null;
+  const title = prog(t, s.label, s.label + 0.6, expoOut);
+  const titleOut = prog(t, s.exit, s.exit + 0.3, expoIn);
+  const focus = prog(t, s.gap, s.gap + 0.4, expoOut);
+  return (
+    <AbsoluteFill>
+      <div
+        dir="rtl"
+        style={{
+          position: 'absolute',
+          left: 90,
+          right: 90,
+          top: 520,
+          textAlign: 'center',
+          fontFamily: AF.ar,
+          fontWeight: 700,
+          fontSize: 66,
+          color: A.text,
+          opacity: title * (1 - titleOut),
+          transform: `translateY(${(1 - title) * 24 - titleOut * 30}px)`,
+        }}
+      >
+        وين عم يوقف السلوك؟
+      </div>
+      {BAR_W.map((bw, i) => {
+        const grow = prog(t, barStart(i), barStart(i) + 0.7, expoOut);
+        const back = prog(t, s.exit + i * 0.04, s.exit + 0.35 + i * 0.04, expoIn);
+        const w = bw * grow * (1 - back);
+        const k = prog(t, s.count + i * 0.15, s.count + i * 0.15 + 1.4, expoOut);
+        const inGap = i === 2 || i === 3;
+        const cap = i === 2 ? A.alert : A.accent;
+        return (
+          <div
+            key={i}
+            dir="rtl"
+            style={{
+              position: 'absolute',
+              top: BAR_Y0 + i * BAR_STEP,
+              left: BAR_R - w,
+              width: w,
+              height: BAR_H,
+              overflow: 'hidden',
+              background: inGap ? `rgba(244,241,234,${lerp(0.07, 0.1, focus)})` : A.textFaint,
+              borderRight: `6px solid ${cap}`,
+              borderRadius: 6,
+              opacity: inGap ? 1 : lerp(1, 0.4, focus),
+              display: 'flex',
+              alignItems: 'center',
+              justifyContent: 'space-between',
+              padding: '0 28px',
+              boxSizing: 'border-box',
+              whiteSpace: 'nowrap',
+            }}
+          >
+            <span style={{fontFamily: AF.ar, fontSize: 34, color: A.textDim}}>{LABELS[i]}</span>
+            <span
+              dir="ltr"
+              style={{
+                fontFamily: AF.en,
+                fontWeight: 600,
+                fontSize: 54,
+                fontVariantNumeric: 'tabular-nums',
+                color: A.text,
+                unicodeBidi: 'isolate',
+              }}
+            >
+              {Math.round(VALUES[i] * k).toLocaleString('en-US')}
+            </span>
+          </div>
+        );
+      })}
+      <div
+        dir="rtl"
+        style={{
+          position: 'absolute',
+          right: W - 392,
+          top: 1153 - 42,
+          fontFamily: AF.ar,
+          fontWeight: 700,
+          fontSize: 56,
+          lineHeight: 1.5,
+          color: A.alert,
+          opacity: prog(t, s.gap + 0.25, s.gap + 0.65, expoOut) * (1 - titleOut),
+          transform: `translateX(${(1 - prog(t, s.gap + 0.25, s.gap + 0.65, expoOut)) * 20}px)`,
+        }}
+      >
+        الفجوة
+      </div>
+    </AbsoluteFill>
+  );
+};
+
+/* ---------- Scenes 3 → 5: the gap bracket morphs into the glass, then the logo ---------- */
+
+const N = 200;
+const GC: Pt = [900, 960];
+const GR = 110;
+const glassPts = (): Pt[] => {
+  const c = Math.SQRT1_2;
+  const pts: Pt[] = [[GC[0] + (GR + 95) * c, GC[1] + (GR + 95) * c]];
+  for (let k = 0; k <= 96; k++) {
+    const a = Math.PI / 4 + (k / 96) * Math.PI * 2;
+    pts.push([GC[0] + GR * Math.cos(a), GC[1] + GR * Math.sin(a)]);
+  }
+  return pts;
+};
+const FROM = resample(BRACKET, N);
+const TO = resample(glassPts(), N);
+const BRACKET_LEN = BRACKET.slice(1).reduce((s, p, i) => s + Math.hypot(p[0] - BRACKET[i][0], p[1] - BRACKET[i][1]), 0);
+
+const glassCenter = (t: number): Pt => {
+  const s4 = TL.s4;
+  const sweep = prog(t, s4.sweep, s4.sweepEnd, expoInOut);
+  const park = prog(t, s4.sweepEnd + 0.1, s4.sweepEnd + 0.75, expoInOut); // clear the text for the reading hold
+  const home = prog(t, s4.exit + 0.25, TL.s5.shrink, expoInOut);
+  const x = lerp(lerp(GC[0], 180, sweep), 540, park);
+  const y = lerp(lerp(GC[1], 1240, park), 860, home);
+  return [x, y];
+};
+
+const LOGO: Pt = [540, 860];
+const RING_R = 300;
+
+const GapToLogo: React.FC<{t: number}> = ({t}) => {
+  const s3 = TL.s3;
+  const s4 = TL.s4;
+  const s5 = TL.s5;
+  if (t < s3.gap) return null;
+  const draw = prog(t, s3.gap, s3.gap + 0.4, expoOut);
+  const m = prog(t, s4.morph, s4.morphEnd, expoInOut);
+  const [cx, cy] = glassCenter(t);
+  const shrink = 1 - prog(t, s5.shrink, s5.dot, expoIn);
+  const pts = FROM.map((p, i) => [lerp(p[0], TO[i][0], m), lerp(p[1], TO[i][1], m)] as Pt);
+  const lens = prog(t, s4.morphEnd - 0.2, s4.morphEnd + 0.2, expoOut);
+
+  const dotIn = prog(t, s5.shrink + 0.12, s5.dot, expoOut);
+  const toTop = prog(t, s5.dot, s5.ring, expoInOut);
+  const ring = prog(t, s5.ring, s5.ring + 0.8, expoInOut);
+  const ang = -Math.PI / 2 + ring * Math.PI * 2;
+  const dotPos: Pt =
+    t < s5.ring
+      ? [LOGO[0], lerp(LOGO[1], LOGO[1] - RING_R, toTop)]
+      : [LOGO[0] + RING_R * Math.cos(ang), LOGO[1] + RING_R * Math.sin(ang)];
+  const dotFade = 1 - prog(t, s5.ring + 0.65, s5.ring + 0.9, expoIn);
+  const circ = 2 * Math.PI * RING_R;
+
+  return (
+    <svg width={W} height={H} style={{position: 'absolute'}}>
+      {shrink > 0 && (
+        <g transform={`translate(${cx - GC[0]} ${cy - GC[1]})`}>
+          <g transform={`translate(${GC[0]} ${GC[1]}) scale(${shrink}) translate(${-GC[0]} ${-GC[1]})`}>
+            <circle cx={GC[0]} cy={GC[1]} r={GR - 5} fill={A.accent} opacity={0.07 * lens} />
+            <path
+              d={toPath(pts)}
+              fill="none"
+              stroke={mix(A.alert, A.accent, m)}
+              strokeWidth={lerp(6, 12, m)}
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              strokeDasharray={m > 0 ? undefined : `${BRACKET_LEN} ${BRACKET_LEN}`}
+              strokeDashoffset={m > 0 ? undefined : BRACKET_LEN * (1 - draw)}
+            />
+          </g>
+        </g>
+      )}
+      {t >= s5.shrink && (
+        <>
+          <circle
+            cx={LOGO[0]}
+            cy={LOGO[1]}
+            r={RING_R}
+            fill="none"
+            stroke={A.accent}
+            strokeWidth={4}
+            strokeDasharray={`${circ} ${circ}`}
+            strokeDashoffset={circ * (1 - ring)}
+            transform={`rotate(-90 ${LOGO[0]} ${LOGO[1]})`}
+          />
+          <circle cx={dotPos[0]} cy={dotPos[1]} r={14 * dotIn} fill={A.accent} opacity={dotFade} />
+        </>
+      )}
+    </svg>
+  );
+};
+
+/* ---------- Scene 4: reveal under the glass ---------- */
+
+const Reveal: React.FC<{t: number}> = ({t}) => {
+  const s4 = TL.s4;
+  if (t < s4.sweep || t > s4.exit + 0.4) return null;
+  const edge = t < s4.sweepEnd ? glassCenter(t)[0] : 0;
+  const out = prog(t, s4.exit, s4.exit + 0.25, expoIn);
+  const line = (top: number, color: string): React.CSSProperties => ({
+    position: 'absolute',
+    left: 90,
+    right: 90,
+    top,
+    textAlign: 'center',
+    fontFamily: AF.ar,
+    fontWeight: 700,
+    fontSize: 92,
+    lineHeight: 1.3,
+    color,
+  });
+  return (
+    <AbsoluteFill
+      style={{
+        clipPath: `inset(0 0 0 ${edge}px)`,
+        opacity: 1 - out,
+        transform: `translateY(${-30 * out}px)`,
+      }}
+    >
+      <div dir="rtl" style={line(840, A.text)}>
+        مو مشكلة محتوى.
+      </div>
+      <div dir="rtl" style={line(960, A.accent)}>
+        مشكلة ثقة.
+      </div>
+    </AbsoluteFill>
+  );
+};
+
+/* ---------- Scene 5: logo and CTA ---------- */
+
+const Logo: React.FC<{t: number}> = ({t}) => {
+  const s5 = TL.s5;
+  if (t < s5.type) return null;
+  const ls = lerp(0.4, 0.08, prog(t, s5.type, s5.typeEnd, expoOut));
+  const a = prog(t, s5.type, s5.type + 0.35, expoOut);
+  const cta = prog(t, s5.cta, s5.cta + 0.7, expoOut);
+  return (
+    <AbsoluteFill>
+      <div
+        style={{
+          position: 'absolute',
+          left: 0,
+          right: 0,
+          top: LOGO[1] - 70,
+          height: 140,
+          display: 'flex',
+          justifyContent: 'center',
+          alignItems: 'center',
+          fontFamily: AF.en,
+          fontWeight: 600,
+          fontSize: 112,
+          letterSpacing: `${ls}em`,
+          paddingLeft: `${ls}em`, // cancels the trailing letter-space so the word stays centred
+          color: A.text,
+          opacity: a,
+        }}
+      >
+        Aura AI
+      </div>
+      <div
+        dir="rtl"
+        style={{
+          position: 'absolute',
+          left: 90,
+          right: 90,
+          top: 1230,
+          textAlign: 'center',
+          fontFamily: AF.ar,
+          fontWeight: 700,
+          fontSize: 76,
+          lineHeight: 1.4,
+          color: A.text,
+          opacity: cta,
+          transform: `translateY(${(1 - cta) * 30}px)`,
+        }}
+      >
+        اكتبي <span style={{color: A.accent}}>فجوة</span>
+      </div>
+    </AbsoluteFill>
+  );
+};
+
+export const AuraGap: React.FC = () => {
+  useAuraFonts();
+  const frame = useCurrentFrame();
+  const t = frame / FPS;
+  const total = Math.round(TL.duration * FPS);
+  const black = clamp01((frame - (total - 7)) / 6);
+  return (
+    <AbsoluteFill style={{background: A.bg}}>
+      <AbsoluteFill style={{background: 'radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0) 45%, rgba(0,0,0,0.45) 100%)'}} />
+      <Journey t={t} />
+      <Funnel t={t} />
+      <Reveal t={t} />
+      <GapToLogo t={t} />
+      <Logo t={t} />
+      <Hook t={t} frame={frame} />
+      <Grain frame={frame} opacity={0.05} />
+      <AbsoluteFill style={{background: A.black, opacity: black}} />
+    </AbsoluteFill>
+  );
+};
